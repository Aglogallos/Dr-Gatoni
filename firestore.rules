rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Common helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isInstructor() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/students/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/students/$(request.auth.uid)).data.role == "instructor"
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Students matching
    match /students/{studentId} {
      allow get: if isSignedIn() && (isOwner(studentId) || isInstructor());
      allow list: if isSignedIn() && isInstructor(); // Instructors can list all students
      allow create: if isSignedIn() && (isOwner(studentId) || isInstructor()) && 
        request.resource.data.uid == studentId &&
        request.resource.data.role in ['student', 'instructor'];
      allow update: if isSignedIn() && (isOwner(studentId) || isInstructor()) && 
        request.resource.data.uid == studentId &&
        (!('role' in request.resource.data) || request.resource.data.role == resource.data.role || isInstructor());
      allow delete: if isSignedIn() && isInstructor();
    }

    // Questions matching
    match /questions/{questionId} {
      allow get, list: if isSignedIn(); // All signed-in students can view questions
      allow create: if isSignedIn() && isInstructor() && isValidId(questionId) &&
        request.resource.data.id == questionId;
      allow update: if isSignedIn() && isInstructor() && isValidId(questionId) &&
        request.resource.data.id == questionId;
      allow delete: if isSignedIn() && isInstructor();
    }

    // Student Progress matching
    match /students/{studentId}/progress/{questionId} {
      allow get: if isSignedIn() && (isOwner(studentId) || isInstructor());
      allow list: if isSignedIn() && (isOwner(studentId) || isInstructor());
      allow create, update: if isSignedIn() && isOwner(studentId) && isValidId(questionId) &&
        request.resource.data.studentId == studentId &&
        request.resource.data.questionId == questionId;
      allow delete: if isSignedIn() && isOwner(studentId);
    }

    // Student Theory Progress matching
    match /students/{studentId}/theoryProgress/{unitId} {
      allow get, list: if isSignedIn() && (isOwner(studentId) || isInstructor());
      allow create, update: if isSignedIn() && isOwner(studentId) && isValidId(unitId) &&
        request.resource.data.unitId == unitId;
      allow delete: if isSignedIn() && isOwner(studentId);
    }
  }
}
